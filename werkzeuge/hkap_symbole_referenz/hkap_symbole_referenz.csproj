<Project Sdk="Microsoft.NET.Sdk">
  <!-- Modul 5 A-S 2: zieht die Heizungs- und Kältesymbole aus dem HKAP-Quelltext (nur lesen) in eine JSON-Referenz für die Tests
       (tests/daten/hkap/schema_symbole_heizung.json). Die Quelldatei wird nur einkompiliert, nie verändert.
       Aufruf: dotnet run mit dem Projekt werkzeuge/hkap_symbole_referenz und dem Ausgabepfad tests/daten/hkap/schema_symbole_heizung.json
       als Argument nach dem Trenner. Anderer Quellort: Eigenschaft HkapQuelle (Pfad der SchemaSymbole.cs). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8600;CS8602;CS8604;CS0618</NoWarn>
    <HkapQuelle Condition="'$(HkapQuelle)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))\OneDrive\Claude_Code\AufgabenProtokolle.Web\Services\SchemaSymbole.cs</HkapQuelle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(HkapQuelle)" Link="Quelle\SchemaSymbole.cs" />
  </ItemGroup>
</Project>
