<Project>
  <!-- Build-Ausgabe ausserhalb von OneDrive. HLKS_BUILD erlaubt getrennte Ausgabeordner, wenn mehrere
       Bauläufe gleichzeitig arbeiten (z. B. parallele Agenten); sonst %USERPROFILE%\HLKS_CAD_build. -->
  <PropertyGroup>
    <HlksBuildBasis Condition="'$(HLKS_BUILD)' != ''">$(HLKS_BUILD)</HlksBuildBasis>
    <HlksBuildBasis Condition="'$(HLKS_BUILD)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))\HLKS_CAD_build</HlksBuildBasis>
    <HlksBuildRoot>$(HlksBuildBasis)\$(MSBuildProjectName)\</HlksBuildRoot>
    <BaseIntermediateOutputPath>$(HlksBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(HlksBuildRoot)bin\</BaseOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Versionsangaben: Smart App Control sperrt sonst unsignierte Builds ohne Herstellerangaben (HKAP 01.10.2026) -->
    <Company>H+K Planungs AG</Company>
    <Product>HLKS-CAD</Product>
    <Copyright>H+K Planungs AG 2026</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- HK_XR (eigenes Projekt, nur lokal, Umzug U3 vom 26.10.2026): KICAD verweist auf die Verbindungs-Bibliothek HkXr.Verbindung.
       Ordner aus HLKS_HKXR (Prüfung und Desktop: eigene Arbeitskopie %USERPROFILE%\HK_XR_fuer_kicad auf dem Stand aus extern\hk_xr.commit),
       sonst der Nachbarordner Claude_Code\HK_XR. Ohne HK_XR lässt sich KICAD nicht bauen (Cloud-Sitzungen). -->
  <PropertyGroup>
    <HkXrOrdner Condition="'$(HLKS_HKXR)' != ''">$(HLKS_HKXR)</HkXrOrdner>
    <HkXrOrdner Condition="'$(HLKS_HKXR)' == ''">$(MSBuildThisFileDirectory)..\HK_XR</HkXrOrdner>
  </PropertyGroup>
</Project>
