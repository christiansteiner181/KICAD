<?xml version="1.0" encoding="UTF-8"?>
<!--
  KICAD (H+K Planungs AG), Modul 7 Teil B2: Teil des W3C-Metaschemas http://www.w3.org/2001/XMLSchema.xsd, den ids.xsd importiert.
  .NET (System.Xml.Schema) kann das vollständige Metaschema nicht übersetzen ("Pattern constraining facet is prohibited for
  anySimpleType", geprüft 20.10.2026). ids.xsd braucht daraus nur das Element xs:restriction (für idsValue) und die Attributgruppe
  xs:occurs (minOccurs/maxOccurs der Anwendbarkeit). Diese beiden stehen hier so, wie sie im W3C-Metaschema (XML Schema 1.0, Teil 1,
  Struktur simpleRestrictionModel und Attributgruppe occurs) aufgebaut sind; der Wert der Facetten ist vereinfacht als xs:string
  geführt (im Original anySimpleType). Die Datei ersetzt nur beim Laden den W3C-Import (IdsSchema.LokalAufloesen); ids.xsd bleibt
  unverändert. Nicht ändern ohne Testlauf IdsSchemaTests.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="kicad-teil-1">
  <xs:complexType name="facetErsatz">
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:attribute name="fixed" type="xs:boolean" use="optional"/>
    <xs:attribute name="id" type="xs:ID" use="optional"/>
  </xs:complexType>
  <xs:element name="restriction">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="minExclusive" type="xs:facetErsatz"/>
        <xs:element name="minInclusive" type="xs:facetErsatz"/>
        <xs:element name="maxExclusive" type="xs:facetErsatz"/>
        <xs:element name="maxInclusive" type="xs:facetErsatz"/>
        <xs:element name="totalDigits" type="xs:facetErsatz"/>
        <xs:element name="fractionDigits" type="xs:facetErsatz"/>
        <xs:element name="length" type="xs:facetErsatz"/>
        <xs:element name="minLength" type="xs:facetErsatz"/>
        <xs:element name="maxLength" type="xs:facetErsatz"/>
        <xs:element name="enumeration" type="xs:facetErsatz"/>
        <xs:element name="whiteSpace" type="xs:facetErsatz"/>
        <xs:element name="pattern" type="xs:facetErsatz"/>
      </xs:choice>
      <xs:attribute name="base" type="xs:QName" use="optional"/>
      <xs:attribute name="id" type="xs:ID" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:attributeGroup name="occurs">
    <xs:attribute name="minOccurs" type="xs:nonNegativeInteger" use="optional" default="1"/>
    <xs:attribute name="maxOccurs" use="optional" default="1">
      <xs:simpleType>
        <xs:union memberTypes="xs:nonNegativeInteger">
          <xs:simpleType>
            <xs:restriction base="xs:NMTOKEN">
              <xs:enumeration value="unbounded"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:union>
      </xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>
</xs:schema>
