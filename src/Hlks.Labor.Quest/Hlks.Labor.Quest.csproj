<Project Sdk="Microsoft.NET.Sdk">
	<!-- Brillen-App «XR-Labor» (XR-Labor L0, entwurf/labor-app.md), Fassung für den PC: Simulator mit Maus-Händen und automatische Prüfung ohne Brille
	     (Argument «pruefen» mit Anzahl Bilder, wie src/Hlks.Quest). Die Fassung für die Brille ist Projects\Android\Hlks.Labor.Quest.Android.csproj (gleiche Quellen).
	     Quellen: alle von src/Hlks.Quest (gemeinsame Bedienung; in L0 noch mit den Labor-Dateien) ohne deren Marke.Kicad.cs, dazu die eigenen Dateien hier
	     (Marke.XrLabor.cs). Assets (Shader, Symbole), xr_farben.json und Fassung.targets ebenfalls aus src/Hlks.Quest bzw. kataloge.
	     Bewusst nicht in HLKS_CAD.slnx (wie Hlks.Quest). Bauausgabe wie alle Projekte unter HLKS_BUILD bzw. %USERPROFILE%\HLKS_CAD_build\Hlks.Labor.Quest. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Hlks.Quest</RootNamespace>
		<ApplicationIcon>Platforms\Net\App.ico</ApplicationIcon>
		<!-- Assets der gemeinsamen App; am PC neben die DLL nach «Assets» (Program.cs sucht dort) -->
		<SKAssetFolder>..\Hlks.Quest\Assets</SKAssetFolder>
		<SKAssetDestination>Assets</SKAssetDestination>
	</PropertyGroup>

	<ItemGroup>
		<!-- Eigene Dateien: die Brillen-Fassung (Projects) und Android-Teile nicht. -->
		<Compile Remove="Projects\**" />
		<EmbeddedResource Remove="Projects\**" />
		<None Remove="Projects\**" />
		<Compile Remove="**\*.Android.cs" />
		<Compile Remove="Platforms\Android\**" />

		<!-- Gemeinsame Quellen aus src/Hlks.Quest ohne deren Marke (Marke.Kicad.cs) und ohne Android-Teile. -->
		<Compile Include="..\Hlks.Quest\**\*.cs"
		         Exclude="..\Hlks.Quest\obj\**;..\Hlks.Quest\bin\**;..\Hlks.Quest\Projects\**;..\Hlks.Quest\Marke.Kicad.cs;..\Hlks.Quest\**\*.Android.cs;..\Hlks.Quest\Platforms\Android\**"
		         Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Festgelegt auf 0.3.11 wie Hlks.Quest (Entscheid Quest App 23.10.2026, modul-xr.md). -->
		<PackageReference Include="StereoKit" Version="0.3.11" />
	</ItemGroup>

	<ItemGroup>
		<!-- Rechenregeln und Netz-Teil ohne StereoKit, gemeinsam mit der KICAD-App. -->
		<ProjectReference Include="..\Hlks.Xr\Hlks.Xr.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Farben der App aus dem Katalog (wie Hlks.Quest.csproj). -->
		<EmbeddedResource Include="..\..\kataloge\xr_farben.json" LogicalName="xr_farben.json" />
	</ItemGroup>

	<!-- Fassung und Commit der App (hallo.app), dieselbe Regel wie die KICAD-App. -->
	<Import Project="..\Hlks.Quest\Fassung.targets" />
</Project>
