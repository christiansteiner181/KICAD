<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Hlks.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hlks.Kern\Hlks.Kern.csproj" />
    <!-- Verbindung zur Brillen-App «H+K XR» (Netzzugang, Kopplung, Kanal, App installieren, Netz einrichten, Oberfläche «Brille»): HK_XR, Umzug U3 26.10.2026.
         Die Skripte für «Netz einrichten …» und die Oberfläche unter /hkxr/ bringt der Verweis mit. -->
    <ProjectReference Include="$(HkXrOrdner)\src\HkXr.Verbindung\HkXr.Verbindung.csproj" />
    <Using Include="HkXr.Verbindung" />
  </ItemGroup>

  <!-- Oberfläche: während der Entwicklung direkt aus dem Quellordner (Änderungen ohne Neubau sichtbar),
       sonst aus der Kopie neben der Programmdatei. -->
  <ItemGroup>
    <AssemblyMetadata Include="QuellWebRoot" Value="$(MSBuildProjectDirectory)\wwwroot" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
