<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Hlks.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hlks.Kern\Hlks.Kern.csproj" />
  </ItemGroup>

  <!-- Oberfläche: während der Entwicklung direkt aus dem Quellordner (Änderungen ohne Neubau sichtbar),
       sonst aus der Kopie neben der Programmdatei. -->
  <ItemGroup>
    <AssemblyMetadata Include="QuellWebRoot" Value="$(MSBuildProjectDirectory)\wwwroot" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
