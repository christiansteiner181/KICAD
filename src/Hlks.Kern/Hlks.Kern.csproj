<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hlks.Kern</RootNamespace>
  </PropertyGroup>

  <!-- Frage 42 (14.11.2026): Programmstand = Zeit des letzten Commits (Unix-Sekunden) für «neuerer Programmstand → nur lesend» (Projekt.Programmstand).
       cmd.exe verlangt ein verdoppeltes Prozentzeichen, sh ein einfaches; übernommen werden nur Ziffern (ohne git: kein Programmstand = 0). -->
  <Target Name="ProgrammstandAusGit" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git log -1 --format=%25%25ct" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(Programmstand)' == '' And '$(OS)' == 'Windows_NT'">
      <Output TaskParameter="ConsoleOutput" PropertyName="ProgrammstandRoh" />
    </Exec>
    <Exec Command="git log -1 --format=%25ct" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(Programmstand)' == '' And '$(OS)' != 'Windows_NT'">
      <Output TaskParameter="ConsoleOutput" PropertyName="ProgrammstandRoh" />
    </Exec>
    <PropertyGroup Condition="'$(Programmstand)' == '' And '$([System.Text.RegularExpressions.Regex]::IsMatch(&quot;$(ProgrammstandRoh)&quot;, &quot;^[0-9]+%24&quot;))' == 'True'">
      <Programmstand>$(ProgrammstandRoh)</Programmstand>
    </PropertyGroup>
    <ItemGroup Condition="'$(Programmstand)' != ''">
      <AssemblyMetadata Include="Programmstand" Value="$(Programmstand)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Polygon-Vereinigung, -Differenz und -Versatz (Wandanschlüsse, Öffnungen, Raumgrenzen). Boost Software License. -->
    <PackageReference Include="Clipper2" Version="1.5.4" />
    <!-- PDF-Ausgabe der Planblätter (Vektor). Bewusst 6.2.4: letzte Fassung unter MIT (ab 6.5 AGPL-3.0-only mit
         Lizenzerklärung im Code – geprüft 17.10.2026). Nicht PdfSharpCore wie im HKAP: das zieht SixLabors.ImageSharp
         1.0.4 mit bekannten schweren Sicherheitslücken nach (NU1903). Vor einem Update auf ≥ 6.5 die Lizenz klären. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp bringt Pkcs 8.0.1 mit bekannten Lücken (NU1902/NU1903) mit: auf die gepflegte .NET-10-Fassung heben. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Modul 1b, Grundlagen (Lizenzen und Sicherheitsmeldungen geprüft 17.10.2026, keine bekannten Lücken):
         IFC4 und IFC2x3 lesen (Schemaklassen aus den buildingSMART-EXPRESS-Schemas). CDDL-1.0: Nutzung unverändert
         erlaubt; nur geänderte Dateien der Bibliothek müssten bei Weitergabe offengelegt werden. -->
    <PackageReference Include="Xbim.Essentials" Version="6.1.605" />
    <!-- IFC-Geometrie samt Booleans (OpenCascade), Entscheid Christian 02.11.2026; CDDL-1.0 bzw. OCCT LGPL-2.1 mit Ausnahme, unverändert genutzt -->
    <PackageReference Include="Xbim.Geometry" Version="6.3.891-netcore" />
    <!-- DWG (AC1014–AC1032) und DXF direkt lesen, ohne ODA File Converter. MIT. -->
    <PackageReference Include="ACadSharp" Version="3.8.0" />
    <!-- PDF-Seiten als Bild rendern (PDFium, BSD). MIT. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- Modul 2, Herstellerunterlagen lesen (Lizenzen vom Hauptlauf geprüft 18.10.2026, Fassungen festgeschrieben):
         PDF-Text mit Lage und Vektorpfade. Apache-2.0. Paket-Id ist «PdfPig» (Namensraum UglyToad.PdfPig); die Id «UglyToad.PdfPig» auf nuget.org ist ein fremdes Paket (1.7.0-custom-5) und hat keine 0.1.16. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- XLSX lesen (Typentabellen der Hersteller). MIT. -->
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <!-- HTML-Leser für Herstellerseiten (Internet-Recherche, Lizenz vom Hauptlauf geprüft 30.09.2026), genau diese Fassung. MIT. -->
    <PackageReference Include="AngleSharp" Version="1.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo H+K für den Plankopf (Kopie aus AufgabenProtokolle.Web/Assets/hk-logo.png) -->
    <EmbeddedResource Include="Plan\hk-logo.png" LogicalName="Hlks.Kern.Plan.hk-logo.png" />
    <!-- BIM to field (entwurf/bim-to-field.md): Betrachter der Baustellen-Webseite und three.js r160 (MIT) aus der Oberfläche -->
    <EmbeddedResource Include="Baustelle\betrachter.html" LogicalName="Hlks.Kern.Baustelle.betrachter.html" />
    <EmbeddedResource Include="Baustelle\betrachter.css" LogicalName="Hlks.Kern.Baustelle.betrachter.css" />
    <EmbeddedResource Include="Baustelle\betrachter.js" LogicalName="Hlks.Kern.Baustelle.betrachter.js" />
    <EmbeddedResource Include="Baustelle\icon.svg" LogicalName="Hlks.Kern.Baustelle.icon.svg" />
    <EmbeddedResource Include="Baustelle\icon.png" LogicalName="Hlks.Kern.Baustelle.icon.png" />
    <EmbeddedResource Include="..\Hlks.Web\wwwroot\lib\three\three.module.js" LogicalName="Hlks.Kern.Baustelle.three.module.js" Link="Baustelle\three.module.js" />
    <EmbeddedResource Include="..\Hlks.Web\wwwroot\lib\three\addons\controls\OrbitControls.js" LogicalName="Hlks.Kern.Baustelle.OrbitControls.js" Link="Baustelle\OrbitControls.js" />
    <EmbeddedResource Include="..\Hlks.Web\wwwroot\lib\three\LICENSE" LogicalName="Hlks.Kern.Baustelle.LICENSE" Link="Baustelle\LICENSE" />
  </ItemGroup>

</Project>
