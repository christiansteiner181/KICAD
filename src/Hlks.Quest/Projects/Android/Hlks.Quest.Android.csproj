<Project Sdk="Microsoft.NET.Sdk">
	<!-- Brillen-App «H+K XR» (Modul XR; seit H+K XR E1 eine App für alle Werkzeuge: KICAD, XR-Labor …), Fassung für die Meta Quest. Quellen aus ..\..\
	     (wie Hlks.Quest.csproj). Bis E1 «KICAD» (ch.hkplanung.kicad.quest); die zweite App «XR-Labor» (src/Hlks.Labor.Quest, ch.hkplanung.xrlabor) entfällt.
	     Bau: dotnet publish -c Release -f net10.0-android → <Bauordner>\Hlks.Quest.Android\bin\Release\net10.0-android\publish\ch.hkplanung.xr-Signed.apk
	     (Bauordner HLKS_BUILD bzw. %USERPROFILE%\HLKS_CAD_build; abgelegt von werkzeuge\quest_app_bereitstellen.ps1 in %USERPROFILE%\HLKS_CAD_werkzeuge\hk_xr).
	     Android SDK und JDK: lokal unter %USERPROFILE%\HLKS_CAD_werkzeuge, sonst wie von der Workload gefunden. -->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<TargetType>Exe</TargetType> <!-- Einstieg über Program.Main wie am PC -->
		<ApplicationId>ch.hkplanung.xr</ApplicationId> <!-- H+K XR E1: gleich Hlks.Xr.Netz.XrApp.Kennung (Test WerkzeugTests) -->
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<RootNamespace>Hlks.Quest</RootNamespace>
		<ReadOnlyProject>true</ReadOnlyProject>

		<SKOpenXRLoader>Standard</SKOpenXRLoader>
		<SKAssetFolder>..\..\Assets</SKAssetFolder>
		<SKAssetDestination>Assets</SKAssetDestination>

		<!-- XR-Geräte laufen auf älteren Android-Fassungen (targetSdkVersion 32). -->
		<NoWarn>XA4211;XA1006;XA4301</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<HlksWerkzeuge>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))\HLKS_CAD_werkzeuge</HlksWerkzeuge>
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(HlksWerkzeuge)\android-sdk')">$(HlksWerkzeuge)\android-sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(HlksWerkzeuge)\jdk-17')">$(HlksWerkzeuge)\jdk-17</JavaSdkDirectory>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="StereoKit" Version="0.3.11" />
	</ItemGroup>

	<ItemGroup>
		<!-- Rechenregeln und Netz-Teil ohne StereoKit (P1, P4a); net10.0, läuft unverändert auf Android. -->
		<ProjectReference Include="..\..\..\Hlks.Xr\Hlks.Xr.csproj" />
	</ItemGroup>

	<!-- Android-Ordner auf Platforms\Android zeigen lassen, sonst sucht der Bau im Projektordner. -->
	<PropertyGroup>
		<AndroidManifest          >..\..\Platforms\Android\AndroidManifest.xml</AndroidManifest>
		<MonoAndroidResourcePrefix>..\..\Platforms\Android\Resources</MonoAndroidResourcePrefix>
		<MonoAndroidAssetsPrefix  >..\..\Platforms\Android\Assets</MonoAndroidAssetsPrefix>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\**\*.cs" Exclude="..\..\obj\**;..\..\bin\**;..\..\Projects\**" />

		<!-- Nur-PC-Teile nicht übersetzen. -->
		<Compile Remove="..\..\**\*.Net.cs" />
		<Compile Remove="..\..\Platforms\Net\**\*.cs" />

		<Compile Update="..\..\**" Visible="false" />
		<None    Update="..\..\**" Visible="false" />
		<Content Update="..\..\**" Visible="false" />

		<Compile Update="..\..\**\*.Android.cs" Visible="true" />
		<Compile Update="..\..\Platforms\Android\**\*.cs" Visible="true" />

		<!-- V1a: Farben der App aus dem Katalog, mitgeliefert (wie Hlks.Quest.csproj). -->
		<EmbeddedResource Include="..\..\..\..\kataloge\xr_farben.json" LogicalName="xr_farben.json" />
		<!-- XR-Labor S1: eingebaute Fassung der Spielwiese (wie Hlks.Quest.csproj). -->
		<EmbeddedResource Include="..\..\..\..\kataloge\labor_spielwiese.json" LogicalName="labor_spielwiese.json" />
	</ItemGroup>

	<!-- P5b: Fassung und Commit der App (hallo.app, Messprotokolle); dieselbe Fassung wie ApplicationDisplayVersion. -->
	<PropertyGroup>
		<HlksAppFassung>$(ApplicationDisplayVersion)</HlksAppFassung>
	</PropertyGroup>
	<Import Project="..\..\Fassung.targets" />
</Project>
