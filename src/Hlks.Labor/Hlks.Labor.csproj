<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- XR-Labor (Labor-App), PC-Teil (entwurf/labor-app.md, Stufe L0). Eigener Server neben KICAD: Port 5430 (nur localhost), Netzzugang der Labor-Brille
       5340/5341. Der Transport (Zugang, Kopplung, Zertifikat, Suche, Kanal, Installation der App per adb) kommt per Verweis aus Hlks.Web, nicht als Kopie
       (Entscheid im Kopf von LaborDienste.cs). -->

  <PropertyGroup>
    <RootNamespace>Hlks.Labor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hlks.Web\Hlks.Web.csproj" />
    <ProjectReference Include="..\Hlks.Kern\Hlks.Kern.csproj" />
    <!-- S1: den Katalog der Spielwiese mit demselben Leser prüfen wie die Brille (Hlks.Xr.Labor.SpielwieseKatalog; rein, ohne StereoKit) -->
    <ProjectReference Include="..\Hlks.Xr\Hlks.Xr.csproj" />
  </ItemGroup>

  <!-- Oberfläche: während der Entwicklung direkt aus dem Quellordner (Änderungen ohne Neubau sichtbar), sonst aus der Kopie neben der Programmdatei.
       Die Kopie heisst labor_wwwroot: unter wwwroot legt der Verweis auf Hlks.Web dessen Oberfläche ab (Content mit CopyToOutputDirectory wird mitkopiert);
       das Labor nutzt daraus nur css/ und js/ (LaborOberflaeche.cs). -->
  <ItemGroup>
    <AssemblyMetadata Include="QuellWebRoot" Value="$(MSBuildProjectDirectory)\wwwroot" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" TargetPath="labor_wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
