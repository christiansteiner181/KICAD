  <ItemGroup>
    <!-- T1: gemeinsames Hilfsmittel für Umgebungsvariablen -->
    <Compile Include="..\Hlks.Kern.Tests\TestUmgebung.cs" Link="TestUmgebung.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hlks.Web\Hlks.Web.csproj" />
    <ProjectReference Include="..\..\src\Hlks.Kern\Hlks.Kern.csproj" />
